# Public Mapbox token (safe in client). Enables Directions + optional Mapbox tiles.
VITE_MAPBOX_TOKEN=

# Frontend → API. Leave empty to use Vite proxy `/api` → localhost:3001
VITE_API_BASE_URL=

# Server
PORT=3001
DATABASE_URL=
# Example PostGIS: postgresql://helpme:helpme@localhost:5432/helpme

# Overpass mirrors (comma-separated). Rotate on 429/504.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
PLACES_REFRESH_DAYS=7

# Optional enrichment (OFF by default — check provider terms before enabling)
ENABLE_MAPPLS=false
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
ENABLE_GOOGLE=false
GOOGLE_PLACES_API_KEY=

# Voice / AI / alerts (server-only)
# Gnani: get a key at https://app.gnani.ai/voice  (server-only, never VITE_)
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_VOICE_HI=Nalini
GNANI_VOICE_EN=Devika
GNANI_VOICE_HINGLISH=Poorvi
LLM_API_KEY=
TELEGRAM_BOT_TOKEN=
